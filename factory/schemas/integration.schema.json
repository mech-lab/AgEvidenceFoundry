{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agevidence.dev/factory/schemas/integration.schema.json",
  "title": "AgEvidence Foundry Integration",
  "type": "object",
  "required": ["id", "name", "category", "evidence_types"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "evidence_types": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
