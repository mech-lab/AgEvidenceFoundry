{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agevidence.dev/commercial/schemas/naming.schema.json",
  "title": "Company Naming Decision",
  "type": "object",
  "required": ["tests", "territories", "decision"],
  "properties": {
    "tests": {
      "type": "object",
      "required": ["buyer_recognition", "role_discipline", "land_motion_fit", "expansion_permission", "investor_signal"],
      "additionalProperties": {
        "type": "object",
        "required": ["question", "score", "evidence_refs"],
        "properties": {
          "question": { "type": "string" },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "territories": {
      "type": "object",
      "required": ["institutional", "infrastructure", "venture_brand"]
    },
    "decision": {
      "type": "object",
      "required": ["selected", "rationale"]
    }
  },
  "additionalProperties": true
}
