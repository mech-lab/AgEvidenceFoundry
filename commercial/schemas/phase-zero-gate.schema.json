{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agevidence.dev/commercial/schemas/phase-zero-gate.schema.json",
  "title": "Phase 0 Gate",
  "type": "object",
  "required": ["phase_zero_gate"],
  "properties": {
    "phase_zero_gate": {
      "type": "object",
      "required": ["problem", "reliance", "buyer", "artifact", "pricing", "architecture", "outcome"],
      "properties": {
        "problem": { "type": "object" },
        "reliance": { "type": "object" },
        "buyer": { "type": "object" },
        "artifact": { "type": "object" },
        "pricing": {
          "type": "object",
          "required": ["buying_unit_tested", "budget_owner_identified", "budget_source_identified", "price_tests", "minimum_evidence_level", "required_strong_signal", "land_price_range_defined", "expansion_model_hypothesis_defined"]
        },
        "architecture": {
          "type": "object",
          "required": ["decision_file", "disposition_required", "allowed_dispositions", "final_disposition_locked", "rationale_required", "counterfactual_required"],
          "properties": {
            "disposition_required": { "const": true },
            "allowed_dispositions": {
              "type": "array",
              "items": { "enum": ["spinout_company", "agevidence_product"] },
              "minItems": 2,
              "uniqueItems": true
            },
            "final_disposition_locked": { "const": true },
            "rationale_required": { "const": true },
            "counterfactual_required": { "const": true }
          }
        },
        "outcome": {
          "type": "object",
          "required": ["allowed", "current"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
