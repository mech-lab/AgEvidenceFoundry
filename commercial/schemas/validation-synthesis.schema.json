{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agevidence.dev/commercial/schemas/validation-synthesis.schema.json",
  "title": "Phase 0 Synthesis",
  "type": "object",
  "required": ["phase_zero"],
  "properties": {
    "phase_zero": {
      "type": "object",
      "required": ["status", "sample", "problem", "reliance", "buyer", "artifact", "pricing", "decision"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unvalidated", "active", "synthesized", "passed", "failed"]
        },
        "sample": {
          "type": "object",
          "required": ["interviews", "organizations"]
        },
        "problem": { "type": "object" },
        "reliance": { "type": "object" },
        "buyer": { "type": "object" },
        "artifact": { "type": "object" },
        "pricing": {
          "type": "object",
          "required": ["pricing_evidence_level", "synthesis"]
        },
        "decision": {
          "type": "object",
          "required": ["action"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
